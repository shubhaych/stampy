# GENERATED by `npm run env:build` from env/*.env. Do not edit; edit your feature fragment.
# Copy to .env.local (git-ignored). Secrets stay empty here and never go in web/.

# ===== env/ops.env =====
# --- core (.env.local per machine) ---
MACHINE=a                          # a | b
SLOT=0                             # 0-9 port offset for parallel worktrees (web 3000+SLOT, worker 8787+SLOT)
APP_MODE=fixture                   # fixture | live
INTEGRATOR=0                       # 1 only for the person running the demo machine

# --- database (SQLite; the QC historical data is the main table) ---
DB_PATH=data/db/cleancase.db       # built per machine by `npm run db:build`, git-ignored

# --- worker ---
WORKER_PORT=                       # leave empty to derive 8787+SLOT
MEDIA_SIGNING_SECRET=              # openssl rand -hex 32
DEMO_WORKER_CODE=cleancase-worker
DEMO_SUPERVISOR_CODE=cleancase-supervisor

# ===== env/web-core.env =====
# --- web (browser-safe NEXT_PUBLIC_* only; never a key) ---
NEXT_PUBLIC_DATA=fixture           # fixture = web reads packages/contracts fixtures | live = worker REST + SSE
NEXT_PUBLIC_WORKER_URL=            # leave empty to derive http://localhost:8787+SLOT

# ===== env/seats.env =====
# --- Anthropic (all Claude roles; document vision; post-call extraction) ---
AI_MODE=fixture                    # fixture | live
AI_DAILY_RUN_LIMIT=60
ANTHROPIC_API_KEY=                 # worker only
ANTHROPIC_MODEL_REASONING=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
DOC_READER_MODE=fixture            # fixture | vision (Claude)

# --- recompute cross-check ---
POLICYENGINE_MODE=off              # off | api
POLICYENGINE_API_URL=https://api.policyengine.org

# --- Manaspace (OPTIONAL, only if a role needs it; confirm the product and docs with the human first) ---
MANUS_MODE=off                     # off | live
MANUS_API_KEY=                     # placeholder name; worker only
MANUS_API_BASE=

# ===== env/policy.env =====
# --- Moss (policy retrieval) ---
MOSS_MODE=local                    # local = in-process BM25 fallback (labelled) | live
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=                  # never reaches the browser
MOSS_INDEX=cleancase-policy

# ===== env/voice-engine.env =====
# --- Deepgram voice agent ---
VOICE_MODE=fixture                 # fixture | live
DEEPGRAM_API_KEY=                  # worker only
DEEPGRAM_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse
DEEPGRAM_LISTEN_MODEL=nova-3
DEEPGRAM_SPEAK_MODEL=aura-2-thalia-en
VOICE_THINK_PROVIDER=anthropic
VOICE_THINK_MODEL=claude-haiku-4-5 # an id from Deepgram's supported list, not the Anthropic API namespace (verify)
VOICE_COUNTERPART=sim              # sim | human | pstn
VOICE_DAILY_CALL_LIMIT=6
VOICE_MAX_CALL_SECONDS=240
VOICE_ALLOWED_NUMBERS=             # pstn only: E.164 allow-list of team phones
TWILIO_ACCOUNT_SID=                # P2 (also used by MESSAGING_PROVIDER=twilio)
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ===== env/planner.env =====
# --- outreach (household text, employer email) ---
MESSAGING_PROVIDER=fixture         # fixture | twilio (SMS and WhatsApp sandbox) | whatsapp_cloud (Meta)
SMS_ALLOWED_NUMBERS=               # E.164 allow-list of team phones; live messages go nowhere else
TWILIO_MESSAGING_FROM=             # SMS number or WhatsApp sandbox sender (reuses TWILIO_* in voice-engine.env)
WHATSAPP_PHONE_NUMBER_ID=          # whatsapp_cloud only
WHATSAPP_ACCESS_TOKEN=             # whatsapp_cloud only; use a system-user token for the demo
WHATSAPP_WABA_ID=
WHATSAPP_TEMPLATE_UPLOAD=          # approved template with one URL variable (the upload link)
WHATSAPP_VERIFY_TOKEN=             # webhook verification string you choose
EMAIL_PROVIDER=fixture             # fixture | gmail | resend (draft-only; the worker clicks send)
EMAIL_ALLOWED_RECIPIENTS=          # team addresses only for live sends
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=               # scopes: gmail.send (+ gmail.readonly only if reading replies)
GMAIL_SENDER=
RESEND_API_KEY=
HOUSEHOLD_UPLOAD_BASE_URL=         # leave empty to derive http://localhost:3000+SLOT; a tunnel URL on demo day
OUTREACH_DAILY_LIMIT=20

# ===== env/qc-data.env =====
# --- QC data ---
QC_FILE_PATH=data/qc/raw/<fill in: file name>
QC_FISCAL_YEAR=2024
QC_SAMPLE_SEED=7
