# --- outreach (household text, employer email) ---
MESSAGING_PROVIDER=fixture         # fixture | twilio (SMS and WhatsApp sandbox) | whatsapp_cloud (Meta)
SMS_ALLOWED_NUMBERS=               # E.164 allow-list of team phones; live messages go nowhere else
TWILIO_MESSAGING_FROM=             # SMS number or WhatsApp sandbox sender (reuses TWILIO_* in voice-engine.env)
WHATSAPP_PHONE_NUMBER_ID=          # whatsapp_cloud only
WHATSAPP_ACCESS_TOKEN=             # whatsapp_cloud only; use a system-user token for the demo
WHATSAPP_WABA_ID=
WHATSAPP_TEMPLATE_UPLOAD=          # approved template with one URL variable (the upload link)
WHATSAPP_VERIFY_TOKEN=             # webhook verification string you choose
EMAIL_PROVIDER=fixture             # fixture | gmail | resend (draft-only; the worker clicks send)
EMAIL_ALLOWED_RECIPIENTS=          # team addresses only for live sends
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=               # scopes: gmail.send (+ gmail.readonly only if reading replies)
GMAIL_SENDER=
RESEND_API_KEY=
HOUSEHOLD_UPLOAD_BASE_URL=         # leave empty to derive http://localhost:3000+SLOT; a tunnel URL on demo day
OUTREACH_DAILY_LIMIT=20
