# --- Deepgram voice agent ---
VOICE_MODE=fixture                 # fixture | live
DEEPGRAM_API_KEY=                  # worker only
DEEPGRAM_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse
DEEPGRAM_LISTEN_MODEL=nova-3
DEEPGRAM_SPEAK_MODEL=aura-2-thalia-en
VOICE_THINK_PROVIDER=anthropic
VOICE_THINK_MODEL=claude-haiku-4-5 # an id from Deepgram's supported list, not the Anthropic API namespace (verify)
VOICE_COUNTERPART=sim              # sim | human | pstn
VOICE_DAILY_CALL_LIMIT=6
VOICE_MAX_CALL_SECONDS=240
VOICE_ALLOWED_NUMBERS=             # pstn only: E.164 allow-list of team phones
TWILIO_ACCOUNT_SID=                # P2 (also used by MESSAGING_PROVIDER=twilio)
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
