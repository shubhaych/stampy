# --- core (.env.local per machine) ---
MACHINE=a                          # a | b
SLOT=0                             # 0-9 port offset for parallel worktrees (web 3000+SLOT, worker 8787+SLOT)
APP_MODE=fixture                   # fixture | live
INTEGRATOR=0                       # 1 only for the person running the demo machine

# --- database (SQLite; the QC historical data is the main table) ---
DB_PATH=data/db/cleancase.db       # built per machine by `npm run db:build`, git-ignored

# --- worker ---
WORKER_PORT=                       # leave empty to derive 8787+SLOT
MEDIA_SIGNING_SECRET=              # openssl rand -hex 32
DEMO_WORKER_CODE=cleancase-worker
DEMO_SUPERVISOR_CODE=cleancase-supervisor
